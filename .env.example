# ============================================================
# .env.example — Lifewise 环境变量样板（不入真实密钥）
#
# 复制为 .env 并填写真实值。.env 已在 .gitignore 中忽略。
#
# 轮换周期（CLAUDE.md §7.1）：
#   - DB_PASSWORD    ：180 天
#   - REDIS_PASSWORD ：180 天
#   - JWT_SECRET     ：90 天
#   - VAPID_PRIVATE_KEY：90 天
#
# 严格遵循：
#   - plan-deploy-nginx.md §4 环境变量清单
#   - technical-architecture.md §5.4 密钥管理
# ============================================================

# --- 数据库（180 天轮换）---
# 生成示例：openssl rand -base64 24
DB_PASSWORD=change-me-180d-lorem-ipsum
POSTGRES_DB=lifewise
POSTGRES_USER=lifewise

# --- Redis（180 天轮换）---
# 生成示例：openssl rand -base64 24
REDIS_PASSWORD=change-me-180d-dolor-sit-amet

# --- JWT（90 天轮换）---
# 生成示例：openssl rand -base64 48
JWT_SECRET=change-me-90d-consectetur-adipiscing
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# --- Ollama / AI 推理 ---
OLLAMA_MODEL=deepseek:8b
OLLAMA_BASE_URL=http://ai:11434

# --- Web Push VAPID 密钥（90 天轮换）---
# 生成：npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@lifewise.local

# --- 系统 ---
TZ=Asia/Shanghai
LOG_LEVEL=INFO
SPRING_PROFILES_ACTIVE=compose