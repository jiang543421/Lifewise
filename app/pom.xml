<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml — Lifewise 模块化单体

  范围（与 plan-data-flyway 对齐）：
    - 仅承载当前 plan 范围（数据层 + JPA 基类 + TDD 测试），不引入业务模块代码
    - 业务模块按 plan-01-task.md ~ plan-06-ai.md / plan-shared-infra.md 等模块单独追加

  Java 版本说明：
    - 本地环境当前为 JDK 17（Maven / mvn 调用验证）
    - Docker 运行时仍按 technical-architecture.md §1.2 使用 eclipse-temurin:21-jre
    - Spring Boot 3.3 同时支持 Java 17 / 21，语法只使用 17 即可移植的特性
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.lifewise</groupId>
    <artifactId>lifewise-app</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>lifewise-app</name>
    <description>Lifewise modular monolith</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <embedded.postgres.version>2.1.1</embedded.postgres.version>
    </properties>

    <dependencies>
        <!-- Web（MVP 占位启动器；后续由 plan-shared-infra 升级为完整 web 配置） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA（Hibernate 6） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC 驱动（Spring Boot BOM 管版本，但 alibabacloud 镜像偶发解析失败时显式覆盖） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway 10.x：core + postgres adapter 在 9.x 后拆为独立 artifact -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- 校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          H2 内存数据库：SharedIntegrationContextTest 验证 Spring Context 装配时使用，
          避免依赖真实 PostgreSQL。仅 test scope。
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          zonky/embedded-postgres：本机无 Docker daemon 时的 CI 替代方案
          （生产仍走 docker-compose db — PG 15-alpine — 见 docker-compose.yml）。
          通过 JVM 子进程启动真实 PG 15 二进制；分区 / JSONB / CHECK 全支持。
        -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.0.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>zonky</id>
            <url>https://repo.zonky.io/</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- failsafe 用于 *IT.java 集成测试（Testcontainers 启动开销大，归到 verify 阶段） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
