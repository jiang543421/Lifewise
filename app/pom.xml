<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml — Lifewise 模块化单体

  范围（与 plan-data-flyway 对齐）：
    - 仅承载当前 plan 范围（数据层 + JPA 基类 + TDD 测试），不引入业务模块代码
    - 业务模块按 plan-01-task.md ~ plan-06-ai.md / plan-shared-infra.md 等模块单独追加

  Java 版本说明：
    - 本地环境当前为 JDK 17（Maven / mvn 调用验证）
    - Docker 运行时仍按 technical-architecture.md §1.2 使用 eclipse-temurin:21-jre
    - Spring Boot 3.3 同时支持 Java 17 / 21，语法只使用 17 即可移植的特性
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.lifewise</groupId>
    <artifactId>lifewise-app</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>lifewise-app</name>
    <description>Lifewise modular monolith</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <embedded.postgres.version>2.1.1</embedded.postgres.version>
    </properties>

    <dependencies>
        <!-- Web（MVP 占位启动器；后续由 plan-shared-infra 升级为完整 web 配置） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA（Hibernate 6） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC 驱动（Spring Boot BOM 管版本，但 alibabacloud 镜像偶发解析失败时显式覆盖） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway 10.x：core + postgres adapter 在 9.x 后拆为独立 artifact -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- 校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          spring-security-crypto：BCryptPasswordEncoder（plan-shared-infra §1
          PasswordEncoderConfig 强制 strength=12；不引完整 spring-boot-starter-security，
          等 SecurityFilterChain / Redis Lua 真正需要时再追加 starter）
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- AOP（plan-shared-infra §1 RateLimitAspect / AuditAspect；RED 阶段只需 starter，
             切面实现待后续 plan 推进） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          H2 内存数据库：SharedInfraContextTest（plan-shared-infra IT 兜底）+
          SharedIntegrationContextTest（plan-shared-integration M2）验证 Spring
          Context 装配时使用，避免依赖真实 PostgreSQL / embedded-postgres 子进程。
          仅 test scope。
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          zonky/embedded-postgres：本机无 Docker daemon 时的 CI 替代方案
          （生产仍走 docker-compose db — PG 15-alpine — 见 docker-compose.yml）。
          通过 JVM 子进程启动真实 PG 15 二进制；分区 / JSONB / CHECK 全支持。
        -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.0.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>zonky</id>
            <url>https://repo.zonky.io/</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- failsafe 用于 *IT.java 集成测试（Testcontainers 启动开销大，归到 verify 阶段） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
<!--
              JaCoCo：行/分支覆盖 (CLAUDE.md §6.1 ≥ 80% 关键路径)
              - version 0.8.12 (main 升级；worktree 用 0.8.11)
              - report phase = test (worktree 设定，mvn verify 已验证)
              - check gate = verify (A 组 polish #3, line coverage ≥ 0.80)
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <configuration>
                    <!--
                      A 组 polish #6：exclude 范围对齐"测试在哪"（CLAUDE.md §6.1）
                      0.80 threshold 不动；check gate 在共享 infra 包 enforce。
                      followup #2（IT 覆盖率聚合）落地后可逐步收窄。
                        - shared/integration/**  : 测试在 *IT (21 IT passing)
                        - common/**              : JPA 基类，plan-data-flyway 引入
                        - LifewiseApplication    : Spring Boot main，无业务逻辑
                        - **/*Exception.class    : 3 个 ≤4 LOC 的小 exception
                    -->
                    <excludes>
                        <exclude>com/lifewise/shared/integration/**/*.class</exclude>
                        <exclude>com/lifewise/common/**/*.class</exclude>
                        <exclude>com/lifewise/LifewiseApplication.class</exclude>
                        <exclude>**/*Exception.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!--
                      A 组 polish #3：覆盖率阈值 gate（CLAUDE.md §6.1 ≥ 80% 行覆盖）。
                      check goal 读取 prepare-agent 收集的数据，verify 阶段强制阈值，
                      跌破 80% 直接 fail build — 把"人工看 report"变成"自动 fail"。
                      JaCoCo rule 结构：element = 容器层级（BUNDLE/PACKAGE/CLASS/METHOD），
                      counter = 度量类型（LINE/INSTRUCTION/BRANCH），value = COVEREDRATIO。
                    -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
